page {
  min-height: 100%;
  background: #fffaf4;
  color: #352417;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

.page {
  min-height: 100vh;
  padding: 28rpx 28rpx 48rpx;
  box-sizing: border-box;
}

.section {
  margin-bottom: 22rpx;
}

.card {
  background: #fffefd;
  border: 2rpx solid #f3e6d2;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 10rpx 30rpx rgba(87, 54, 24, 0.045);
}

.row {
  display: flex;
  align-items: center;
}

.between {
  justify-content: space-between;
}

.muted {
  color: #9a7b58;
}

.title {
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.25;
}

.subtitle {
  font-size: 24rpx;
  color: #9a7b58;
  line-height: 1.45;
}

.amount {
  font-size: 58rpx;
  font-weight: 800;
  color: #5b351c;
  line-height: 1.1;
}

.button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 90rpx;
  border-radius: 22rpx;
  background: #5b351c;
  color: #fff9f1;
  font-size: 28rpx;
  font-weight: 800;
  border: 0;
  box-shadow: 0 10rpx 22rpx rgba(91, 53, 28, 0.14);
}

.button.secondary {
  background: #fffefd;
  color: #5b351c;
  border: 2rpx solid #f1dfc5;
  box-shadow: none;
}

.button.ghost {
  background: #fff8ec;
  border: 2rpx solid #f1dfc5;
  box-shadow: none;
}

.input {
  height: 88rpx;
  border-radius: 20rpx;
  background: #fff9f1;
  padding: 0 24rpx;
  box-sizing: border-box;
  border: 2rpx solid #f0dfc7;
  color: #352417;
}

.grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14rpx;
}

.chip {
  min-height: 76rpx;
  border-radius: 20rpx;
  background: #fff9f1;
  border: 2rpx solid #f0dfc7;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #6b5137;
}

.chip.active {
  background: #5b351c;
  color: #fff8ed;
  border-color: #5b351c;
}

.empty {
  padding: 40rpx 0;
  text-align: center;
  color: #9b7b55;
}
