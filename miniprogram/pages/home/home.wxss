.hero {
  position: relative;
  min-height: 456rpx;
  padding: 34rpx;
  border-radius: 32rpx;
  overflow: hidden;
  background: #fff0c8;
  box-shadow: 0 16rpx 42rpx rgba(174, 104, 32, 0.12);
}

.hero-bear {
  position: absolute;
  right: -36rpx;
  top: 18rpx;
  width: 330rpx;
  height: 330rpx;
  border-radius: 50%;
  box-shadow: 0 10rpx 34rpx rgba(177, 101, 28, 0.12);
}

.hero-copy {
  position: relative;
  z-index: 1;
  max-width: 360rpx;
}

.summary {
  position: relative;
  z-index: 1;
  margin-top: 118rpx;
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
}

.budget-pill {
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 254, 253, 0.82);
  color: #5b351c;
  font-size: 24rpx;
  font-weight: 700;
}

.budget-pill.danger {
  background: #ffe3df;
  color: #9d2d1f;
}

.comment {
  position: relative;
  z-index: 1;
  margin-top: 26rpx;
  gap: 16rpx;
  padding: 18rpx 20rpx;
  border-radius: 22rpx;
  background: rgba(255, 254, 253, 0.9);
  color: #5b351c;
  line-height: 1.5;
  font-size: 25rpx;
}

.comment-bear {
  width: 58rpx;
  height: 58rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.quick-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.stats-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.stat-value {
  margin-top: 12rpx;
  font-size: 38rpx;
  font-weight: 800;
}

.income {
  color: #327451;
}

.expense {
  color: #a44b35;
}

.heading {
  margin-bottom: 12rpx;
}

.small {
  font-size: 30rpx;
}

.link {
  color: #7a5a3b;
  font-size: 26rpx;
  font-weight: 700;
}

.bill {
  padding: 22rpx 0;
  border-top: 2rpx solid #f5eadc;
}

.bill-name {
  font-size: 30rpx;
  font-weight: 700;
}

.empty-state {
  padding: 36rpx 0;
  text-align: center;
}

.empty-bear {
  width: 132rpx;
  height: 132rpx;
  border-radius: 50%;
  margin-bottom: 14rpx;
}
