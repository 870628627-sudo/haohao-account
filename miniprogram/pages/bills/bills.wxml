<view class="page">
  <view class="section tool-head">
    <image class="tool-bear" src="/assets/bear-ledger.jpg" mode="aspectFill"></image>
    <view>
      <view class="title">账单</view>
      <view class="subtitle">每一笔都别想逃过豪豪的眼睛</view>
    </view>
  </view>

  <view class="section card filter-card">
    <view class="row between">
      <picker mode="date" fields="month" value="{{month}}" bindchange="setMonth">
        <view class="month-picker">{{month}}</view>
      </picker>
      <button class="mini-btn" bindtap="exportCsv">导出 CSV</button>
    </view>
  </view>

  <view class="section card">
    <view wx:if="{{bills.length === 0}}" class="empty-state">
      <image class="empty-bear" src="/assets/bear-ledger.jpg" mode="aspectFill"></image>
      <view class="muted">这个月还没有账单，钱包暂时拥有神秘感。</view>
    </view>
    <view wx:for="{{bills}}" wx:key="id" class="bill row between">
      <view>
        <view class="bill-name">{{item.category}}</view>
        <view class="muted">{{item.date}} {{item.note}}</view>
      </view>
      <view class="right">
        <view class="{{item.type === 'income' ? 'income' : 'expense'}}">{{item.type === 'income' ? '+' : '-'}}¥{{item.amountText}}</view>
        <view class="delete" data-id="{{item.id}}" bindtap="deleteBill">删除</view>
      </view>
    </view>
  </view>
</view>
