.tool-head {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 6rpx 2rpx 10rpx;
}

.tool-bear {
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  box-shadow: 0 8rpx 20rpx rgba(174, 104, 32, 0.14);
}

.filter-card {
  padding: 18rpx 20rpx;
}

.month-picker {
  padding: 16rpx 22rpx;
  border-radius: 18rpx;
  background: #fff9f1;
  color: #5b351c;
  font-weight: 800;
}

.mini-btn {
  height: 68rpx;
  line-height: 68rpx;
  padding: 0 22rpx;
  border-radius: 18rpx;
  background: #5b351c;
  color: #fff9f1;
  font-weight: 800;
  font-size: 24rpx;
}

.bill {
  padding: 24rpx 0;
  border-bottom: 2rpx solid #f5eadc;
}

.bill:last-child {
  border-bottom: 0;
}

.bill-name {
  font-size: 30rpx;
  font-weight: 700;
}

.right {
  text-align: right;
  font-weight: 700;
}

.income {
  color: #327451;
}

.expense {
  color: #a44b35;
}

.delete {
  margin-top: 8rpx;
  color: #9b7b55;
  font-size: 24rpx;
  font-weight: 400;
}

.empty-state {
  padding: 36rpx 0;
  text-align: center;
}

.empty-bear {
  width: 132rpx;
  height: 132rpx;
  border-radius: 50%;
  margin-bottom: 14rpx;
}
