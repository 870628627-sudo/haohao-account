.add-head {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 6rpx 2rpx 10rpx;
}

.add-bear {
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  box-shadow: 0 8rpx 20rpx rgba(174, 104, 32, 0.12);
}

.type-switch {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8rpx;
  padding: 8rpx;
  background: #fff9f1;
  border-radius: 22rpx;
  border: 2rpx solid #f0dfc7;
}

.type {
  height: 76rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #8d6e4c;
  font-weight: 800;
}

.type.active {
  background: #5b351c;
  color: #fff8ed;
}

.money-input {
  height: 150rpx;
  font-size: 72rpx;
  font-weight: 800;
  color: #5b351c;
  text-align: center;
}

.category-grid {
  margin: 18rpx 0 26rpx;
}

.form-row {
  margin-top: 24rpx;
}

.picker {
  display: flex;
  align-items: center;
  margin-top: 10rpx;
}

.save {
  margin-top: 34rpx;
}
