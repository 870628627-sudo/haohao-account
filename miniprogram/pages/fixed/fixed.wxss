.tool-head {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 6rpx 2rpx 10rpx;
}

.tool-bear {
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  box-shadow: 0 8rpx 20rpx rgba(174, 104, 32, 0.14);
}

.input-gap {
  margin-top: 18rpx;
}

.picker {
  display: flex;
  align-items: center;
  margin-top: 18rpx;
}

.save {
  margin-top: 28rpx;
}

.small {
  font-size: 30rpx;
}

.item {
  padding: 22rpx 0;
  border-top: 2rpx solid #f5eadc;
}

.item-name {
  font-size: 30rpx;
  font-weight: 700;
}

.mini-btn {
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 18rpx;
  border-radius: 18rpx;
  background: #fff9f1;
  color: #5b351c;
  border: 2rpx solid #f0dfc7;
  font-weight: 800;
  font-size: 24rpx;
}

.empty-state {
  padding: 36rpx 0;
  text-align: center;
}

.empty-bear {
  width: 132rpx;
  height: 132rpx;
  border-radius: 50%;
  margin-bottom: 14rpx;
}
