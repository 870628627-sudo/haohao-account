<view class="page">
  <view class="section tool-head">
    <image class="tool-bear" src="/assets/bear-ledger.jpg" mode="aspectFill"></image>
    <view>
      <view class="title">月度预算</view>
      <view class="subtitle">给钱包划条线，豪豪负责盯着</view>
    </view>
  </view>

  <view class="section card">
    <picker mode="date" fields="month" value="{{month}}" bindchange="setMonth">
      <view class="input picker">{{month}}</view>
    </picker>
    <input class="input budget-input" type="digit" placeholder="例如 2000" value="{{total}}" bindinput="setTotal" />
    <button class="button" bindtap="save">保存预算</button>
  </view>
</view>
